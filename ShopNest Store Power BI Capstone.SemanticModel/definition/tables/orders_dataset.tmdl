table orders_dataset
	lineageTag: 1017b711-8dcd-4f06-b1c8-d54a6ca5b466

	measure Delayed_Order =
			
			CALCULATE(
			    COUNTROWS(orders_dataset),
			    orders_dataset[delivery_status] = "Delayed"
			)
		formatString: 0
		lineageTag: ebbfd730-1363-4f44-800e-e307a7699570

	measure 'On-Time Orders' =
			
			CALCULATE(
			    DISTINCTCOUNT(orders_dataset[order_id]),
			    orders_dataset[delivery_status] = "On Time"
			)
		formatString: 0
		lineageTag: 4353ba51-13a6-4e07-a7af-c4bf64fdbdfa

	column order_id
		dataType: string
		lineageTag: 527d02ba-2d49-480a-a88a-7d28afcb4603
		summarizeBy: none
		sourceColumn: order_id

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column customer_id
		dataType: string
		lineageTag: 3fab0765-97c6-45c5-9ebc-00cddf5c76b5
		summarizeBy: none
		sourceColumn: customer_id

		annotation SummarizationSetBy = Automatic

	column order_status
