		formatString: General Date
		lineageTag: 00d7f37d-67ea-49a6-9c24-f2a62b0177e8
		summarizeBy: none
		sourceColumn: order_approved_at

		variation Variation
			isDefault
			relationship: 092570d7-4fe1-4594-bbb7-c9c17465a901
			defaultHierarchy: LocalDateTable_ec1120c6-a0a0-4705-8ef7-80f073277841.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column order_delivered_carrier_date
		dataType: dateTime
		formatString: General Date
		lineageTag: b6934135-db2d-45e1-aa7d-ae63f787e257
		summarizeBy: none
		sourceColumn: order_delivered_carrier_date

		variation Variation
			isDefault
			relationship: 685bc034-3f81-4fc0-82a5-004b2fea8f8d
			defaultHierarchy: LocalDateTable_69d17a22-f872-4c9d-88a9-27fb8c1ea3be.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column order_delivered_customer_date
		dataType: dateTime
		formatString: General Date
		lineageTag: 0a3544ae-8079-4eca-8b44-db02b5837322
		summarizeBy: none
		sourceColumn: order_delivered_customer_date

		variation Variation
			isDefault
			relationship: f1080764-094c-490d-8a8f-fcc929b26b3f
			defaultHierarchy: LocalDateTable_f83c0064-0c44-4343-a8aa-39bdc86a27d7.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column order_estimated_delivery_date
		dataType: dateTime
		formatString: General Date
		lineageTag: 16c3e5ad-985d-40f5-a92e-00603b5ff72c
		summarizeBy: none
		sourceColumn: order_estimated_delivery_date

		variation Variation
			isDefault
			relationship: 8e5ad2e1-158c-414b-acfe-699792691006
			defaultHierarchy: LocalDateTable_fb0dfa5d-c36c-4139-a5ab-12e2933622b5.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column delivery_status =
			
			IF(
			    orders_dataset[order_estimated_delivery_date] < orders_dataset[order_delivered_customer_date],
			    "Delayed",
			    "On Time"
			)
		lineageTag: ec59c5d6-8c15-4085-a761-1532463ea49e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column purchased_month =
			
			FORMAT(
			    orders_dataset[order_purchase_timestamp],
			    "MMM YYYY"
			)
		lineageTag: df837285-c91d-4c9f-a9cc-5f62029ea8f0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column YEAR =
			
			FORMAT(
			    orders_dataset[order_purchase_timestamp],
			    "YYYY"
			)
		lineageTag: d5529f32-13ae-41ba-a39b-16932b62c39a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Quarter =
			
			"Q" & FORMAT('orders_dataset'[order_purchase_timestamp], "Q")
		lineageTag: 0b2c1747-b1d4-4cf3-be9c-f49056762f88
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

